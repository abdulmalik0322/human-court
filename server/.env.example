# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required in production. Any long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Zero-config JSON store paths (used when MONGO_URI is empty).
HC_DATA_DIR=./data
HC_UPLOAD_DIR=./uploads

# Set to use MongoDB (production path). When empty, the JSON store is used.
MONGO_URI=

# AI assessment engine. When AI_API_KEY is empty, the built-in local
# heuristic engine is used (zero-config, honest about its limits).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Password-reset email (SMTP). When unset, forgot-password returns the
# token directly in development only, and a clear setup message in production.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Human Court <no-reply@example.com>
