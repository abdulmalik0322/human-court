# Human Court — environment example (backend + frontend).
# Copy to .env for local development (PowerShell):  Copy-Item .env.example .env
# Placeholders only — never put real secrets in this file, and never commit a
# real .env to git. The server reads .env from the REPO ROOT (dotenv).

# --- Required ---
# Port the Express API listens on. The Vite dev proxy forwards /api here.
PORT=4000

# Secret used to sign session cookies. REQUIRED for anything real.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (Dev fallback exists, but the server warns loudly when it is used.)
JWT_SECRET=

# Where the browser app lives (used for CORS + email links).
CLIENT_URL=http://localhost:5173

# development | test | production
NODE_ENV=development

# --- Database (optional) ---
# Leave empty to use the built-in JSON file store (zero-config, great for
# local development). Set to a MongoDB connection string to use MongoDB
# instead (e.g. a free MongoDB Atlas cluster).
MONGO_URI=

# --- AI assessment (optional) ---
# Leave empty to use the built-in heuristic engine (works out of the box,
# honest about its limits, clearly labeled in the UI).
# Set an API key to use a real LLM via any OpenAI-compatible endpoint.
# Free option: Google AI Studio key (aistudio.google.com/apikey) with the
# Gemini OpenAI-compatible endpoint and a current flash model.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash

# --- Email (optional) ---
# Leave empty and password resets return an honestly-labeled dev token in the
# API response (no email is actually sent). Fill these in to send real emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Human Court <no-reply@example.com>

# --- Frontend (optional) ---
# Public display name of the app.
VITE_APP_NAME=Human Court
